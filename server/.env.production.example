# Copy this file to the repository root as .env for docker compose.
APP_ENV=production
APP_DEBUG=false
PORT=8000

# Use URL-safe characters because Compose builds DATABASE_URL from this value.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
REDIS_URL=redis://redis:6379/0

OTP_DEMO_MODE=false
OTP_DELIVERY_WEBHOOK_URL=https://your-otp-provider.example/send

AGENTROUTER_API_KEY=replace-with-real-provider-key
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=claude-opus-5
AI_USE_FALLBACK_ON_ERROR=true

SEED_ON_STARTUP=false
