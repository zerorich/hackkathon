# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME=maktab-ai-arena
APP_TIMEZONE=Asia/Tashkent
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./maktab.db
# DATABASE_URL=postgresql+asyncpg://maktab:maktab@localhost:5432/maktab

# Redis (optional — in-memory fallback when unset)
# REDIS_URL=redis://localhost:6379/0
REDIS_LEADERBOARD_TTL_SECONDS=60
REDIS_OTP_COOLDOWN_SECONDS=60
REDIS_AI_GENERATION_LIMIT_PER_USER=3

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
OTP_DEMO_MODE=true
OTP_DEMO_CODE=123456

# AgentRouter (OpenAI-compatible)
AGENTROUTER_API_KEY=your-api-key-here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=claude-opus-5
AGENTROUTER_TIMEOUT_SECONDS=120
AGENTROUTER_MAX_RETRIES=3
AI_USE_FALLBACK_ON_ERROR=true

# Concurrency / performance
MAX_CONCURRENT_AI_JOBS=2
HTTP_CLIENT_TIMEOUT_SECONDS=30
HTTP_CLIENT_MAX_CONNECTIONS=20
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# Demo
DEMO_QUESTION_COUNT=5
DUEL_EXPIRY_HOURS=24
SEED_ON_STARTUP=false
